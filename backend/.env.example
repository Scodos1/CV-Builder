# Copy to .env (backend/.env) — never commit real secrets
MONO_ENV=dev   # dev | prod (prod fail-fasts on weak secret / CORS *)
MONO_JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./mono.db
# Prod Postgres example:
# DATABASE_URL=postgresql+psycopg2://mono:secret@localhost:5432/mono
MONO_DB_PATH=./db.json
MONO_CORS_ORIGINS=*
# Prod example: MONO_CORS_ORIGINS=https://your-frontend-domain.com
MONO_ACCESS_TTL=3600
MONO_REFRESH_TTL=2592000
MONO_MAX_RESUME_BYTES=512000
MONO_MAX_AI_TEXT=6000
# Real AI (optional):
# OPENAI_API_KEY=sk-...
# MONO_AI_MODEL=gpt-4o-mini
